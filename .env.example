# Variáveis do Compose de desenvolvimento. É OPCIONAL: o docker-compose.yml já tem estes valores
# como padrão. Copie para .env (na raiz) só se quiser trocar algum. O .env não vai para o git.
#
# Valores SÓ para desenvolvimento local. As portas ficam ligadas a 127.0.0.1.
# Não use estas senhas em nenhum outro ambiente.
# PostgreSQL (superusuário inicial e banco; roles e schema são do boleto-migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=boleto
POSTGRES_PORT=5432
# Valkey (compatível com Redis, ver ADR 0006)
VALKEY_PASSWORD=valkey_dev
VALKEY_PORT=6379
# Mailpit (SMTP sem autenticação e interface web)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Site de documentação (profile docs)
DOCS_PORT=3000
